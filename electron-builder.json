{
  "appId": "com.metaai.webbuilder",
  "productName": "Meta-AI-Web-Builder",
  "directories": {
    "output": "release-builds"
  },
  "files": [
    "dist/**/*",
    "electron-main.cjs",
    "package.json"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "win": {
    "target": ["portable", "zip"]
  },
  "mac": {
    "target": ["dmg", "zip"],
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "linux": {
    "target": ["zip", "tar.gz", "AppImage"]
  }
}
